let cm=new Date();const anchor=new Date(2026,9,23);function isPay(d){return Math.round((new Date(d.getFullYear(),d.getMonth(),d.getDate())-anchor)/86400000)>=0&&Math.round((new Date(d.getFullYear(),d.getMonth(),d.getDate())-anchor)/86400000)%14===0}function iso(d){return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}function events(d){let e=[];if(isPay(d))e.push('pay');if(d.getDate()===15&&d>=new Date(2026,11,15))e.push('vouchers');if(iso(d)==='2026-11-15')e.push('savings');if(['2027-01-01','2027-04-09'].includes(iso(d)))e.push('bonus');return e}function renderCal(){let y=cm.getFullYear(),m=cm.getMonth(),first=new Date(y,m,1).getDay(),n=new Date(y,m+1,0).getDate(),today=new Date();$('#month').textContent=new Intl.DateTimeFormat('en-US',{month:'long',year:'numeric'}).format(cm);$('#calendar').innerHTML=['SUN','MON','TUE','WED','THU','FRI','SAT'].map(x=>`<div class="dow">${x}</div>`).join('')+Array(first).fill('<div></div>').join('');for(let i=1;i<=n;i++){let d=new Date(y,m,i),e=events(d),cl=[i===today.getDate()&&m===today.getMonth()&&y===today.getFullYear()?'today':'',...e].join(' ');let details=[];if(e.includes('pay'))details.push('<b>Payday quincenal</b><br>Pago programado cada 14 días desde el 23 de octubre de 2026.');if(e.includes('savings'))details.push('<b>Caja de ahorro</b><br>Evento especial del 15 de noviembre de 2026.');if(e.includes('vouchers'))details.push('<b>Vales de despensa</b><br>Depósito mensual el día 15, comenzando en diciembre de 2026.');if(e.includes('bonus')){let label=iso(d)==='2027-01-01'?'Hiring bonus 90 días':'Hiring bonus 180 días';details.push('<b>'+label+'</b><br>Evento especial marcado en dorado.')}if(!details.length)details.push('<b>Día regular</b><br>Sin evento de pago configurado.');$('#calendar').insertAdjacentHTML('beforeend',`<div class="day ${cl}">${i}<span class="dots">${e.map(x=>`<i class="dot ${x}"></i>`).join('')}</span><span class="dayTooltip">${details.join('<hr style="border:0;border-top:1px solid #ffffff22;margin:6px 0">')}</span></div>`)}let d=new Date();while(!isPay(d))d.setDate(d.getDate()+1);$('#nextPay').innerHTML=`<b>Próximo payday:</b> ${d.toLocaleDateString('es-MX',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}<br>90 días desde 28/09/2026 → siguiente payday: 01/01/2027. 180 días → siguiente payday: 09/04/2027. Un feriado puede mover el depósito real.`}function moveMonth(n){cm=new Date(cm.getFullYear(),cm.getMonth()+n,1);renderCal()}renderCal();
const brackets=[[.01,416.70,0,.0192],[416.71,3537.15,7.95,.064],[3537.16,6216.15,207.75,.1088],[6216.16,7225.95,499.20,.16],[7225.96,8651.40,660.75,.1792],[8651.41,17448.75,916.20,.2136],[17448.76,27501.60,2795.25,.2352],[27501.61,52505.25,5159.70,.30],[52505.26,70006.95,12660.75,.32],[70006.96,210020.70,18261.30,.34],[210020.71,Infinity,65866.05,.35]];let acc=+localStorage.getItem('moneyAcc')||0,started=+localStorage.getItem('moneyStarted')||0,timer;function curr(v){return new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(v||0)}function sec(){return acc+(started?(Date.now()-started)/1000:0)}function tax(g){if(g<=0)return 0;let b=brackets.find(x=>g>=x[0]&&g<=x[1])||brackets.at(-1);return b[2]+(g-b[0])*b[3]}function drawMoney(){let r=+$ ('#rate').value||0,u=$('#unit').value,ps=u==='minute'?r/60:r/3600,s=sec(),g=u==='minute'?r*60*(+$('#hours').value||0)*(+$('#days').value||0):r*(+$('#hours').value||0)*(+$('#days').value||0),t=tax(g),f=g*(+$('#fund').value||0)/100,o=+$('#other').value||0;$('#earnings').textContent=curr(s*ps);$('#elapsed').textContent=fmt(s)+' conectado';$('#gross').textContent=curr(g);$('#isr').textContent=curr(t);$('#fundAmt').textContent=curr(f);$('#net').textContent=curr(Math.max(0,g-t-f-o));['rate','unit','hours','days','fund','other'].forEach(id=>localStorage.setItem('pay_'+id,$('#'+id).value));$('#startMoney').disabled=!!started}function startMoney(){if(started)return;started=Date.now();localStorage.setItem('moneyStarted',started);timer=setInterval(drawMoney,250);$('#earnings').closest('.money').classList.add('celebrate');setTimeout(()=>$('#earnings').closest('.money').classList.remove('celebrate'),700);coinBurst()}function spinSlots(){['slot1','slot2','slot3'].forEach((id,i)=>{let el=$('#'+id);el.classList.remove('spin');void el.offsetWidth;el.classList.add('spin');setTimeout(()=>el.classList.remove('spin'),700+i*90)})}function coinBurst(){for(let i=0;i<18;i++){let c=document.createElement('i');c.className='coin';c.style.left=(40+Math.random()*20)+'vw';c.style.top='18vh';c.style.setProperty('--x',(Math.random()*500-250)+'px');c.style.animationDelay=(Math.random()*.25)+'s';document.body.appendChild(c);setTimeout(()=>c.remove(),1600)}}function pauseMoney(){if(started){acc+=(Date.now()-started)/1000;started=0;localStorage.setItem('moneyAcc',acc);localStorage.removeItem('moneyStarted')}clearInterval(timer);drawMoney()}function resetMoney(){pauseMoney();acc=0;localStorage.setItem('moneyAcc','0');drawMoney()}['rate','unit','hours','days','fund','other'].forEach(id=>{let v=localStorage.getItem('pay_'+id);if(v!=null)$('#'+id).value=v;$('#'+id).oninput=drawMoney;$('#'+id).onchange=drawMoney});if(started)timer=setInterval(drawMoney,250);drawMoney();
